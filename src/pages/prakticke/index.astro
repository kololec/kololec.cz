---

<BaseLayout
  title="Praktické informace | Kololeč"
  description="Doprava, odpady, internet, služby v okolí a důležité kontakty pro obyvatele Kololeče."
  navItems={subpageNav}
  bodyClass="archive-page practical-page"
  headerSolid
>
  <main id="obsah">
    <section class="archive-hero practical-hero">
      <div class="shell">
        <p class="section-kicker">Praktický rozcestník</p>
        <h1>Praktické informace</h1>
        <p>Užitečné odkazy a kontakty pro každodenní život v Kololeči. Doprava, odpady, internet, služby v okolí i informace pro nové obyvatele na jednom místě.</p>
      </div>
    </section>

    <nav class="practical-nav" aria-label="Rozcestník praktických informací">
      <div class="shell">
        <ul class="practical-nav-list">
          {practicalSections.map((section) => (
            <li><a href={`#${section.id}`}>{section.title}</a></li>
          ))}
        </ul>
      </div>
    </nav>

    <div class="practical-blocks">
      {practicalSections.map((section, index) => {
        const num = `${String(index + 1).padStart(2, '0')} / ${String(practicalSections.length).padStart(2, '0')}`;

        if (section.id === 'doprava') {
          return (
            <section class="practical-block practical-block--wide" id={section.id} aria-labelledby={`${section.id}-title`}>
              <div class="shell">
                <div class="practical-block-head">
                  <p class="section-kicker">{num}</p>
                  <h2 id={`${section.id}-title`}>{section.title}</h2>
                  <p set:html={section.intro}></p>
                </div>

                <div class="transport-modes">
                  <article class="transport-mode">
                    <div class="transport-mode-head">
                      <span class="transport-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M3 11h18"/><path d="M7 16v2M17 16v2"/><circle cx="7.5" cy="13.5" r="1"/><circle cx="16.5" cy="13.5" r="1"/></svg>
                      </span>
                      <h3>Autobusem</h3>
                    </div>
                    <ul class="transport-stops">
                      {transport.bus.map((stop) => (
                        <li>
                          <div class="transport-stop-main">
                            <strong>{stop.name}</strong>
                            <span class="transport-dist">{stop.distance}</span>
                          </div>
                          <p class="transport-dest" set:html={stop.destinations}></p>
                          <span class="transport-links">
                            {stop.departures
                              ? <a class="transport-link" href={stop.departures} target="_blank" rel="noreferrer">Odjezdy →</a>
                              : <span class="transport-soon">Odjezdy doplníme</span>}
                            {stop.timetable && <a class="transport-link" href={stop.timetable} target="_blank" rel="noreferrer">Jízdní řád →</a>}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </article>

                  <article class="transport-mode">
                    <div class="transport-mode-head">
                      <span class="transport-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="13" rx="3"/><path d="M5 10h14"/><path d="M9 16l-2 4M15 16l2 4"/><circle cx="9" cy="13" r="0.9"/><circle cx="15" cy="13" r="0.9"/></svg>
                      </span>
                      <h3>Vlakem</h3>
                    </div>
                    <ul class="transport-stops">
                      {transport.train.map((stop) => (
                        <li>
                          <div class="transport-stop-main">
                            <strong>{stop.name}</strong>
                            <span class="transport-dist">{stop.distance}</span>
                          </div>
                          <p class="transport-dest" set:html={stop.destinations}></p>
                          <span class="transport-links">
                            {stop.departures
                              ? <a class="transport-link" href={stop.departures} target="_blank" rel="noreferrer">Odjezdy →</a>
                              : <span class="transport-soon">Odjezdy doplníme</span>}
                            {stop.timetable && <a class="transport-link" href={stop.timetable} target="_blank" rel="noreferrer">Jízdní řád →</a>}
                          </span>
                        </li>
                      ))}
                    </ul>
                    <figure class="transport-image">
                      <a href="https://www.svestkovadraha.cz/historie" target="_blank" rel="noreferrer">
                        <img src="/assets/svestkova-draha.png" alt="Motorový vůz na Švestkové dráze" loading="lazy" />
                      </a>
                    </figure>
                  </article>

                  <article class="transport-mode">
                    <div class="transport-mode-head">
                      <span class="transport-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l1.8-5A2 2 0 0 1 6.7 6.7h10.6A2 2 0 0 1 19.2 8L21 13"/><path d="M3 13h18v4a1 1 0 0 1-1 1h-1.2a1 1 0 0 1-1-1v-1H6.2v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><circle cx="7" cy="15.4" r="0.7"/><circle cx="17" cy="15.4" r="0.7"/></svg>
                      </span>
                      <h3>Autem</h3>
                    </div>
                    <ul class="transport-distances">
                      {transport.car.distances.map(([place, value]) => (
                        <li><strong>{place}</strong><span>{value}</span></li>
                      ))}
                    </ul>
                    <p class="transport-note">{transport.car.note}</p>
                  </article>
                </div>

                <p class="transport-note transport-tickets">Jízdenky na autobus i vlak jsou v rámci <a href="https://www.kr-ustecky.cz/doprava-usteckeho-kraje" target="_blank" rel="noreferrer">Dopravy Ústeckého kraje (DÚK)</a> integrované – jednou jízdenkou tak zvládnete celou cestu i s přestupy (v rámci Ústeckého kraje). Nejpohodlněji a se slevou je koupíte v mobilní aplikaci <a href="https://www.dukapka.cz/" target="_blank" rel="noreferrer">DÚKApka</a>.</p>

                <div class="practical-actions transport-actions">
                  <a class="button button-outline practical-button" href="https://www.dukapka.cz/" target="_blank" rel="noreferrer">Jízdenky – DÚKApka</a>
                  <a class="button button-outline practical-button" href="https://idos.cz/" target="_blank" rel="noreferrer">Vyhledat spojení (IDOS)</a>
                </div>
              </div>
            </section>
          );
        }

        if (section.id === 'odpady') {
          return (
            <section class="practical-block practical-block--wide" id={section.id} aria-labelledby={`${section.id}-title`}>
              <div class="shell">
                <div class="practical-block-head">
                  <p class="section-kicker">{num}</p>
                  <h2 id={`${section.id}-title`}>{section.title}</h2>
                  <p>{section.intro}</p>
                </div>

                <div class="waste-grid">
                  {waste.map((card) => (
                    <article class="waste-card">
                      <div class="waste-card-head">
                        <span class="waste-icon" aria-hidden="true" set:html={card.icon}></span>
                        <h3>{card.title}</h3>
                      </div>
                      <p set:html={card.text}></p>
                      {card.link && (
                        <a class="waste-link" href={card.link.href} target="_blank" rel="noreferrer">{card.link.label} →</a>
                      )}
                    </article>
                  ))}
                </div>
              </div>
            </section>
          );
        }

        if (section.id === 'voda-energie') {
          return (
            <section class="practical-block practical-block--wide" id={section.id} aria-labelledby={`${section.id}-title`}>
              <div class="shell">
                <div class="practical-block-head">
                  <p class="section-kicker">{num}</p>
                  <h2 id={`${section.id}-title`}>{section.title}</h2>
                  <p>{section.intro}</p>
                </div>

                {currentOutage.active && (
                  <div class="utility-alert" role="alert">
                    <span class="utility-alert-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </span>
                    <div>
                      <strong>Plánovaná odstávka elektřiny</strong>
                      <p>{currentOutage.date}, {currentOutage.time} – {currentOutage.area}</p>
                    </div>
                    <a href={currentOutage.pdf} target="_blank" rel="noreferrer" class="utility-alert-link">Zobrazit PDF →</a>
                  </div>
                )}

                <div class="utility-grid">
                  <article class="utility-card">
                    <div class="utility-card-head">
                      <span class="utility-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 C12 2 5 10 5 15a7 7 0 0 0 14 0C19 10 12 2 12 2z"/></svg>
                      </span>
                      <h3>Voda</h3>
                    </div>
                    <p class="utility-provider"><a href={utilities.water.provider.url} target="_blank" rel="noreferrer">{utilities.water.provider.name}</a></p>
                    <div class="utility-emergency">
                      <span class="utility-emergency-label">Havárie</span>
                      <div class="utility-phones">
                        {utilities.water.emergency.map((tel) => (
                          <a href={`tel:${tel.replace(/ /g,'')}`} class="utility-phone">{tel}</a>
                        ))}
                      </div>
                      <p class="utility-emergency-note" set:html={utilities.water.emergencyNote}></p>
                    </div>
                    <div class="utility-links">
                      {utilities.water.links.map((l) => (
                        <a href={l.href} target="_blank" rel="noreferrer" class="utility-link">{l.label} →</a>
                      ))}
                    </div>
                    <div class="utility-price">
                      <span class="utility-price-value">{utilities.water.price}</span>
                      <p class="utility-price-note" set:html={utilities.water.priceNote}></p>
                    </div>
                  </article>

                  <article class="utility-card">
                    <div class="utility-card-head">
                      <span class="utility-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                      </span>
                      <h3>Elektřina</h3>
                    </div>
                    <p class="utility-provider"><a href={utilities.electricity.provider.url} target="_blank" rel="noreferrer">{utilities.electricity.provider.name}</a></p>
                    <div class="utility-emergency">
                      <span class="utility-emergency-label">Porucha</span>
                      <div class="utility-phones">
                        {utilities.electricity.emergency.map((tel) => (
                          <a href={`tel:${tel.replace(/ /g,'')}`} class="utility-phone">{tel}</a>
                        ))}
                      </div>
                      <p class="utility-emergency-note" set:html={utilities.electricity.emergencyNote}></p>
                    </div>
                    <div class="utility-links">
                      {utilities.electricity.links.map((l) => (
                        <a href={l.href} target="_blank" rel="noreferrer" class="utility-link">{l.label} →</a>
                      ))}
                    </div>
                  </article>

                  <article class="utility-card utility-card--slim">
                    <div class="utility-card-head">
                      <span class="utility-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>
                      </span>
                      <h3>Veřejné osvětlení</h3>
                    </div>
                    <p class="utility-note" set:html={utilities.lighting.note}></p>
                    <div class="utility-links">
                      {utilities.lighting.links.map((l) => (
                        <a href={l.href} target="_blank" rel="noreferrer" class="utility-link">{l.label} →</a>
                      ))}
                    </div>
                  </article>

                  <article class="utility-card utility-card--slim">
                    <div class="utility-card-head">
                      <span class="utility-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v8"/><path d="M5.2 10.2a7 7 0 1 0 13.6 0"/><path d="M3 10h18"/></svg>
                      </span>
                      <h3>Odpadní vody</h3>
                    </div>
                    <p class="utility-note" set:html={utilities.wastewater.note}></p>
                    <div class="utility-links">
                      {utilities.wastewater.links.map((l) => (
                        <a href={l.href} target="_blank" rel="noreferrer" class="utility-link">{l.label} →</a>
                      ))}
                    </div>
                  </article>
                </div>
              </div>
            </section>
          );
        }

        if (section.id === 'urady') {
          return (
            <section class="practical-block practical-block--wide" id={section.id} aria-labelledby={`${section.id}-title`}>
              <div class="shell">
                <div class="practical-block-head">
                  <p class="section-kicker">{num}</p>
                  <h2 id={`${section.id}-title`}>{section.title}</h2>
                  <p>{section.intro}</p>
                </div>

                {/* Tísňové linky */}
                <div class="emergency-strip">
                  <p class="emergency-strip-label">Tísňové linky</p>
                  <ul class="emergency-list">
                    {emergency.map((e) => (
                      <li>
                        <a href={`tel:${e.number}`} class="emergency-number">
                          <strong>{e.number}</strong>
                          <span>{e.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                {/* Hlavní karty */}
                <div class="contacts-grid">
                  {/* MěÚ Třebenice */}
                  <article class="contacts-card contacts-card--main">
                    <div class="contacts-card-head">
                      <span class="utility-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V9l9-5 9 5v12"/><path d="M3 21h18"/><path d="M9 21v-6h6v6"/></svg>
                      </span>
                      <h3>Městský úřad Třebenice</h3>
                    </div>
                    <p class="contacts-address">Paříkovo nám. 1, 411 13 Třebenice</p>
                    <div class="contacts-row">
                      <a href="tel:+420416594301" class="contacts-phone">416 594 301</a>
                      <a href="mailto:podatelna@mesto-trebenice.cz" class="contacts-email">podatelna@mesto-trebenice.cz</a>
                    </div>
                    <dl class="contacts-meta">
                      <div><dt>Datová schránka</dt><dd>445bayh</dd></div>
                      <div><dt>IČO</dt><dd>00264521</dd></div>
                    </dl>
                    <div class="contacts-hours">
                      <p class="contacts-hours-label">Úřední hodiny</p>
                      <table class="contacts-hours-table">
                        {officeHours.map((row) => (
                          <tr>
                            <td>{row.day}</td>
                            <td>{row.hours}</td>
                          </tr>
                        ))}
                      </table>
                    </div>
                    <div class="utility-links">
                      <a href="https://www.mesto-trebenice.cz/oficialni-kontakt" target="_blank" rel="noreferrer" class="utility-link">Kontaktní stránka →</a>
                      <a href="https://www.mesto-trebenice.cz/uredni-deska" target="_blank" rel="noreferrer" class="utility-link">Úřední deska →</a>
                      <a href="https://www.mesto-trebenice.cz/zpravy-z-meu" target="_blank" rel="noreferrer" class="utility-link">Zprávy z MěÚ →</a>
                      <a href="https://www.mesto-trebenice.cz/formulare-a-tiskopisy" target="_blank" rel="noreferrer" class="utility-link">Formuláře a tiskopisy →</a>
                    </div>
                  </article>

                  {/* Pravý sloupec */}
                  <div class="contacts-col">

                    {/* Czech POINT */}
                    <article class="contacts-card">
                      <div class="contacts-card-head">
                        <span class="utility-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M7 15h.01M11 15h2"/></svg>
                        </span>
                        <h3>Czech POINT</h3>
                      </div>
                      <p class="utility-note">Výpisy z rejstříků (trestů, katastru, obchodního, živnostenského a dalších), ověřování podpisů a kopií, autorizovaná konverze, agenda datových schránek. Dostupné na <a href="https://www.mesto-trebenice.cz/podatelna-a-spisovna" target="_blank" rel="noreferrer">podatelně MěÚ Třebenice</a>.</p>
                    </article>

                    {/* Hlášení závad */}
                    <article class="contacts-card">
                      <div class="contacts-card-head">
                        <span class="utility-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        </span>
                        <h3>Hlášení závad a odběr hlášení</h3>
                      </div>
                      <p class="utility-note">Závady veřejného osvětlení, poškozený mobiliář, komunikace nebo jiný problém ve veřejném prostoru hlaste přes <a href="https://mesto-trebenice.uradvmobilu.cz/default/issues" target="_blank" rel="noreferrer"><strong>ÚŘAD v MOBILU</strong></a>. Stejnou aplikací se lze přihlásit k <a href="https://mesto-trebenice.uradvmobilu.cz/default/intro" target="_blank" rel="noreferrer">odběru SMS nebo e-mailových hlášení města</a>.</p>
                    </article>

                    {/* Policie */}
                    <article class="contacts-card">
                      <div class="contacts-card-head">
                        <span class="utility-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </span>
                        <h3>Městská policie Třebenice</h3>
                      </div>
                      <p class="contacts-address">Paříkovo nám. 1, 411 13 Třebenice</p>
                      <div class="contacts-row">
                        <a href="tel:+420602286168" class="contacts-phone">602 286 168</a>
                        <a href="mailto:m.policie@mesto-trebenice.cz" class="contacts-email">m.policie@mesto-trebenice.cz</a>
                      </div>
                      <p class="utility-note">Při akutním ohrožení volejte <strong>158</strong> nebo <strong>112</strong>.</p>
                      <a href="https://www.mesto-trebenice.cz/mestska-policie-1" target="_blank" rel="noreferrer" class="utility-link" style="margin-top: 4px; display: inline-block;">Stránka MP →</a>
                    </article>

                  </div>
                </div>

                {/* Specializované kontakty + MěÚ Lovosice */}
                <p class="contacts-secondary-label">Specializované kontakty MěÚ <small>(ověřeno červen 2026)</small></p>
                <div class="contacts-secondary-grid">
                  {specialists.map((s) => (
                    <article class="contacts-secondary-card">
                      <p class="contacts-secondary-role">{s.role}</p>
                      <p class="contacts-secondary-name">{s.name}</p>
                      <div class="contacts-secondary-links">
                        {s.phone && <a href={`tel:+420${s.phone.replace(/ /g,'')}`}>{s.phone}</a>}
                        {s.mobile && <a href={`tel:+420${s.mobile.replace(/ /g,'')}`}>{s.mobile}</a>}
                        <a href={`mailto:${s.email}`}>{s.email}</a>
                      </div>
                      <a href={s.url} target="_blank" rel="noreferrer" class="waste-link">Více →</a>
                    </article>
                  ))}

                  <article class="contacts-secondary-card contacts-secondary-card--orp">
                    <p class="contacts-secondary-role">Obec s rozšířenou působností</p>
                    <p class="contacts-secondary-name">MěÚ Lovosice</p>
                    <p class="contacts-secondary-address">Školní 407/2, 410 02 Lovosice</p>
                    <div class="contacts-secondary-links">
                      <a href="tel:+420416571111">416 571 111</a>
                      <a href="mailto:podatelna@meulovo.cz">podatelna@meulovo.cz</a>
                    </div>
                    <div class="contacts-secondary-more">
                      <a href="https://www.meulovo.cz/podrobny-kontakt" target="_blank" rel="noreferrer" class="waste-link">Kontakt →</a>
                      <a href="https://www.meulovo.cz/stavebni-urad-a-uzemni-planovani" target="_blank" rel="noreferrer" class="waste-link">Stavební úřad →</a>
                    </div>
                  </article>
                </div>

              </div>
            </section>
          );
        }

        return (
          <section class="practical-block" id={section.id} aria-labelledby={`${section.id}-title`}>
            <div class="shell practical-block-inner">
              <div class="practical-block-head">
                <p class="section-kicker">{num}</p>
                <h2 id={`${section.id}-title`}>{section.title}</h2>
                <p>{section.intro}</p>
              </div>

              <div class="practical-block-body">
                <dl class="practical-list">
                  {section.items.map(([term, detail]) => (
                    <div>
                      <dt>{term}</dt>
                      <dd>{detail}</dd>
                    </div>
                  ))}
                </dl>

                {section.providers && (
                  <div class="provider-table" role="table" aria-label="Přehled poskytovatelů internetu">
                    <div role="row" class="provider-table-head">
                      <span role="columnheader">Poskytovatel</span>
                      <span role="columnheader">Technologie</span>
                      <span role="columnheader">Poznámka</span>
                    </div>
                    {section.providers.map((provider) => (
                      <div role="row">
                        <span role="cell">{provider.name}</span>
                        <span role="cell">{provider.technology}</span>
                        <span role="cell">{provider.note}</span>
                      </div>
                    ))}
                  </div>
                )}

                {section.actions && (
                  <div class="practical-actions">
                    {section.actions.map((action) => (
                      action.href ? (
                        <a class="button button-outline practical-button" href={action.href} target="_blank" rel="noreferrer">{action.label}</a>
                      ) : (
                        <span class="practical-placeholder">{action.label}: {preparing}</span>
                      )
                    ))}
                  </div>
                )}
              </div>
            </div>
          </section>
        );
      })}
    </div>
  </main>
</BaseLayout>

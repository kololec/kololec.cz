---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { subpageNav } from '../../data/nav.mjs';

const placeholder = 'Informace doplníme.';
const preparing = 'Aktuální údaje připravujeme.';

// Doprava má vlastní strukturu (rozdělená podle typu dopravy).
// `departures` = přímý odkaz na odjezdy ze zastávky (doplníme).
const transport = {
  bus: [
    {
      name: 'Třebenice, Kololeč, rozc.',
      distance: '~100 m',
      destinations: 'Nejbližší zastávka u odbočky do obce. Cíle: Libčeves, Lovosice, Litoměřice.',
      departures: 'https://idos.cz/vlakyautobusymhdvse/odjezdy/vysledky/?f=Kolole%C4%8D/T%C5%99ebenice,rozc.&fc=200003',
    },
    {
      name: 'Třebenice, náměstí',
      distance: '~650 m',
      destinations: 'Hlavní zastávka s nejvíce spoji. Cíle: Libčeves, Třebívlice, Lovosice, Litoměřice, Most, Evaň (Libochovice), Klapý, Peruc.',
      departures: 'https://idos.cz/vlakyautobusymhdvse/odjezdy/vysledky/?f=T%C5%99ebenice,,n%C3%A1m.;%20Litom%C4%9B%C5%99ice&fc=200003',
    },
    {
      name: 'Třebenice, Dlažkovická',
      distance: '~700 m',
      destinations: 'Boční ulice u náměstí. Cíle: Lovosice.',
      departures: 'https://idos.cz/vlakyautobusymhdvse/odjezdy/vysledky/?f=T%C5%99ebenice,,Dla%C5%BEkovick%C3%A1;%20Litom%C4%9B%C5%99ice&fc=200003',
    },
  ],
  train: [
    {
      name: 'Třebenice město',
      distance: '~900 m',
      destinations: 'Trať U10 <a href="https://www.svestkovadraha.cz/" target="_blank" rel="noreferrer">Švestková dráha</a> (Litoměřice horní nádraží – Most), směr Litoměřice a Most.',
      departures: 'https://idos.cz/vlakyautobusymhdvse/odjezdy/vysledky/?f=T%C5%99ebenice%20m%C4%9Bsto&fc=100003',
      timetable: 'https://www.svestkovadraha.cz/jizdni-rad',
    },
  ],
  car: {
    note: 'V Kololeči silnice končí, obcí tedy neprojíždí žádná tranzitní doprava. Příjezd je vždy od Třebenic.',
    distances: [
      ['Třebenice (služby, náměstí)', '~1 km'],
      ['Dálnice D8 (sjezd Lovosice)', '~5 km'],
      ['Lovosice', '~9 km'],
      ['Litoměřice', '~16 km'],
      ['Praha', '~70 km'],
    ],
  },
};

// Odpady mají vlastní layout (karty podle druhu odpadu) s proklikem na zdroj.
const iconTrash = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"/><path d="M10 11v6M14 11v6"/></svg>';
const iconSort = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/></svg>';
const iconLeaf = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 18c0-7 6-12 14-13 0 8-5 14-13 14"/><path d="M5 18c2-4 5-7 9-8"/></svg>';
const iconWarning = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 16H3z"/><path d="M12 10v4M12 17h.01"/></svg>';
const iconBuilding = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V9l9-5 9 5v12"/><path d="M3 21h18"/><path d="M9 21v-6h6v6"/></svg>';
const iconCoins = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6.5 12h.01M17.5 12h.01"/></svg>';

const waste = [
  {
    title: 'Směsný odpad',
    icon: iconTrash,
    text: 'Popelnice se vyvážejí zpravidla 1× za 14 dní; přesný den a týden se řídí nálepkou na nádobě. Od roku 2026 se vyvážejí pouze nádoby s RFID čipem – o očipování požádejte na <a href="https://www.mesto-trebenice.cz/ing-jiri-zalovic" target="_blank" rel="noreferrer">městském úřadě</a> (Ing. Žalovič, <a href="tel:+420606054303">606 054 303</a>).',
    link: { label: 'Harmonogram svozu', href: 'https://www.mesto-trebenice.cz/trideny-odpad' },
  },
  {
    title: 'Tříděný odpad v obci',
    icon: iconSort,
    text: 'Kontejnery jsou v Kololeči u trafostanice: papír, barevné sklo, plasty a kovy. Plasty se svážejí přibližně každý týden, papír zhruba 1× za 14 dní, sklo a kovy zhruba 1× za 4 týdny.',
    link: { label: 'Frekvence svozu', href: 'https://www.mesto-trebenice.cz/trideny-odpad' },
  },
  {
    title: 'Bioodpad',
    icon: iconLeaf,
    text: 'Samostatné stanoviště na bioodpad v Kololeči není – větší množství (tráva, větve, listí) patří do <a href="https://www.mesto-trebenice.cz/sberne-misto-bioodpadu" target="_blank" rel="noreferrer">sběrného dvora v Třebenicích</a>. Spalování trávy a listí je zakázané.',
    link: { label: 'Sběrný dvůr', href: 'https://www.mesto-trebenice.cz/sberne-misto-bioodpadu' },
  },
  {
    title: 'Objemný a nebezpečný odpad',
    icon: iconWarning,
    text: 'Nábytek, dřevo, elektro, nebezpečný odpad i textil odevzdáte ve <a href="https://www.mesto-trebenice.cz/sberne-misto-bioodpadu" target="_blank" rel="noreferrer">sběrném dvoře v Třebenicích</a>. Město také občas pořádá mobilní svoz kusového odpadu – termíny hlásí <a href="https://www.mesto-trebenice.cz/uredni-deska" target="_blank" rel="noreferrer">úřední deska</a>.',
    link: { label: 'Sběrný dvůr', href: 'https://www.mesto-trebenice.cz/sberne-misto-bioodpadu' },
  },
  {
    title: 'Sběrný dvůr Třebenice',
    icon: iconBuilding,
    text: 'Žlábkova 34, Třebenice (u ČOV). Otevřeno zpravidla v úterý a čtvrtek odpoledne a v sobotu dopoledne. Určen občanům Třebenic a místních částí včetně Kololeče; elektroodpad zdarma od kohokoli.',
    link: { label: 'Otevírací doba a pravidla', href: 'https://www.mesto-trebenice.cz/sberne-misto-bioodpadu' },
  },
  {
    title: 'Poplatek za odpad',
    icon: iconCoins,
    text: '1 000 Kč za poplatníka a rok, splatný do 30. dubna. Platit lze na pokladně městského úřadu nebo bankovním převodem.',
    link: { label: 'Poplatek za odpad', href: 'https://www.mesto-trebenice.cz/mistni-poplatek-za-odpad' },
  },
];

// Voda a energie
// POZOR: currentOutage odstranit po 2026-06-16T11:00
const currentOutage = {
  active: true, // nastavit na false po skončení odstávky
  date: '16. června 2026',
  time: '7:30–11:00',
  area: 'Většina č. p. v Kololeči (viz PDF)',
  pdf: 'https://www.mesto-trebenice.cz/file/3791041',
};

const utilities = {
  water: {
    provider: { name: 'Severočeské vodovody a kanalizace (SčVK)', url: 'https://www.scvk.cz/zakaznicky-servis/moje-obec/obec/?city_id=565768' },
    emergency: ['601 267 267', '840 111 111'],
    emergencyNote: 'Call centrum – nonstop, dle tarifu operátora. Nebo napište na <a href="https://www.scvk.cz/kontakty/" target="_blank" rel="noreferrer">kontaktní stránce SčVK</a>.',
    links: [
      { label: 'Havárie a odstávky (živý stav)', href: 'https://www.scvk.cz/zakaznicky-servis/moje-obec/obec/?city_id=565768' },
      { label: 'Registrace SMS/e-mail upozornění', href: 'https://portal.scvk.cz/smsinfo' },
    ],
    price: '156,59 Kč / m³ (vč. DPH, vodné + stočné, platnost od 1. 1. 2026)',
    priceNote: 'Cena platí pro region SVS. Celková částka zahrnuje dodání i odvod 1 m³ vody; u nemovitostí bez napojení na kanalizaci se stočné neúčtuje. <a href="https://www.severoceskavoda.cz/vse-o-vode/" target="_blank" rel="noreferrer">Více o cenách →</a>',
    priceUrl: 'https://www.severoceskavoda.cz/vse-o-vode/',
  },
  electricity: {
    provider: { name: 'ČEZ Distribuce', url: 'https://www.cezdistribuce.cz' },
    emergency: ['800 850 860'],
    emergencyNote: 'Zdarma, nonstop pro poruchy; technické požadavky po–pá 8–18 h',
    links: [
      { label: 'Ověřit odstávku / poruchu (Bez Šťávy)', href: 'https://www.bezstavy.cz/' },
      { label: 'Plánované odstávky', href: 'https://www.cezdistribuce.cz/cs/pro-zakazniky/potrebuji-vyresit/stavajici-pripojeni/overeni-planovane-odstavky' },
      { label: 'Registrace upozornění (SMS / e-mail)', href: 'https://www.cezdistribuce.cz/sluzba' },
      { label: 'Aplikace Proud (ČEZ)', href: 'https://www.cezdistribuce.cz/cs/proud' },
    ],
  },
  lighting: {
    links: [
      { label: 'Nahlásit závadu (ÚŘAD v MOBILU)', href: 'https://mesto-trebenice.uradvmobilu.cz/default/issues' },
      { label: 'Kontakt na město', href: 'https://www.mesto-trebenice.cz/oficialni-kontakt' },
    ],
    note: 'Závady veřejného osvětlení hlaste prostřednictvím <a href="https://mesto-trebenice.uradvmobilu.cz/default/issues" target="_blank" rel="noreferrer">ÚŘAD v MOBILU</a> nebo na podatelně MěÚ Třebenice (tel. <a href="tel:+420416594301">416 594 301</a>, <a href="mailto:podatelna@mesto-trebenice.cz">podatelna@mesto-trebenice.cz</a>).',
  },
  wastewater: {
    note: 'Způsob likvidace odpadních vod se může lišit podle konkrétní nemovitosti. <a href="https://prvk.kr-ustecky.cz/prvk/karty/nahled?id=582" target="_blank" rel="noreferrer">Krajský plán rozvoje vodovodů a kanalizací (PRVK)</a> počítá s odváděním odpadních vod z bezodtokových jímek na ČOV Litoměřice.',
    links: [
      { label: 'Karta PRVK – Kololeč', href: 'https://prvk.kr-ustecky.cz/prvk/karty/nahled?id=582' },
      { label: 'SčVK – voda v mé obci', href: 'https://www.scvk.cz/zakaznicky-servis/moje-obec/obec/?city_id=565768' },
    ],
  },
};

// Úřady a důležité kontakty
const emergency = [
  { number: '112', label: 'Tísňové volání (EU)', note: 'jakákoli akutní nouzová situace' },
  { number: '155', label: 'Záchranná služba', note: 'akutní ohrožení života nebo zdraví' },
  { number: '158', label: 'Policie ČR', note: 'akutní bezpečnostní situace' },
  { number: '150', label: 'Hasiči', note: 'požár, nehoda, technický zásah' },
  { number: '156', label: 'Městská policie', note: 'obecná tísňová linka MP' },
];

const officeHours = [
  { day: 'Pondělí', hours: '07:30–11:30 a 12:30–17:00' },
  { day: 'Středa',  hours: '07:30–11:30 a 12:30–17:00' },
  { day: 'Pátek',   hours: '07:30–11:30 a 12:30–14:00' },
  { day: 'Út, Čt',  hours: 'neúřední dny' },
];

// Specializované kontakty – ověřeno 4. 6. 2026; osoby se mohou měnit
const specialists = [
  { role: 'Matrika a evidence obyvatel', name: 'Petra Vaňková, DiS.', phone: '416 594 509', mobile: '601 532 208', email: 'matrika@mesto-trebenice.cz', url: 'https://www.mesto-trebenice.cz/matrika-evidence-obyvatel' },
  { role: 'Stavební a dopravní agenda', name: 'Tereza Kučerová', phone: '416 594 311', mobile: '602 692 960', email: 'kucerova@mesto-trebenice.cz', url: 'https://www.mesto-trebenice.cz/referent-dotaci-stavebni-a-dopravni-cinnosti' },
  { role: 'Životní prostředí a odpady', name: 'Ing. Lenka Jáhenová', phone: '416 594 301', mobile: '601 558 090', email: 'jahenova@mesto-trebenice.cz', url: 'https://www.mesto-trebenice.cz/referent-zivotniho-prostredi' },
  { role: 'Technická správa majetku', name: 'Ing. Jiří Žalovič', mobile: '606 054 303', email: 'zalovic@mesto-trebenice.cz', url: 'https://www.mesto-trebenice.cz/technik-spravy-majetku-mesta' },
];

const practicalSections = [
  {
    id: 'doprava',
    title: 'Doprava',
    intro: 'Do Kololeče se snadno dostanete autem, autobusem i vlakem. Obec zůstává klidná a bez tranzitní dopravy, přitom nejbližší zastávky leží jen pár minut pěšky.',
  },
  {
    id: 'odpady',
    title: 'Odpady',
    intro: 'Sběrná místa, svoz a poplatek za odpad. Konkrétní termíny svozu se liší podle ročního období – aktuální harmonogram proto najdete vždy na webu města Třebenice.',
  },
  {
    id: 'internet',
    title: 'Internet a mobilní signál',
    intro: 'Dostupnost připojení se může lišit podle konkrétního domu a technických možností v místě.',
    items: [
      ['Dostupní internetoví poskytovatelé', preparing],
      ['Dostupné technologie', 'Bezdrátové připojení, DSL, LTE nebo 5G - dostupnost ověříme podle konkrétních poskytovatelů.'],
    ],
    providers: [
      { name: placeholder, technology: preparing, note: 'Doplníme po ověření dostupnosti.' },
    ],
  },
  {
    id: 'voda-energie',
    title: 'Voda a energie',
    intro: 'Kontakty pro havárie, živý stav dodávek a hlášení závad pro vodovod, elektřinu, veřejné osvětlení a plyn.',
  },
  {
    id: 'sluzby',
    title: 'Služby v okolí',
    intro: 'Základní služby jsou dostupné především v nedalekých Třebenicích.',
    items: [
      ['Obchod', placeholder],
      ['Lékárna', placeholder],
      ['Lékař', placeholder],
      ['Pošta', placeholder],
      ['Školy', placeholder],
      ['Restaurace', placeholder],
      ['Výdejní boxy', placeholder],
      ['Sběrný dvůr', placeholder],
    ],
  },
  {
    id: 'urady',
    title: 'Úřady a důležité kontakty',
    intro: 'Kontakt na Městský úřad Třebenice, hlášení závad, Czech POINT, Městská policie Třebenice a tísňové linky.',
  },
  {
    id: 'novi-obyvatele',
    title: 'Pro nové obyvatele a majitele nemovitostí',
    intro: 'Základní orientace pro nové sousedy, vlastníky domů a pozemků.',
    items: [
      ['Katastrální mapa', 'Nahlížení do katastru nemovitostí pro katastrální území Kololeč.'],
      ['Kód katastrálního území', '769584'],
      ['Územní plán', placeholder],
      ['Stavební úřad', placeholder],

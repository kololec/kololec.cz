---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { subpageNav } from '../../data/nav.mjs';

const placeholder = 'Informace doplníme.';
const preparing = 'Aktuální údaje připravujeme.';

// Doprava má vlastní strukturu (rozdělená podle typu dopravy).
// `departures` = přímý odkaz na odjezdy ze zastávky (doplníme).
const transport = {
  bus: [
    {
      name: 'Třebenice, Kololeč, rozc.',
      distance: '~100 m',
      destinations: 'Nejbližší zastávka u odbočky do obce. Cíle: Libčeves, Lovosice, Litoměřice.',
      departures: 'https://idos.cz/vlakyautobusymhdvse/odjezdy/vysledky/?f=Kolole%C4%8D/T%C5%99ebenice,rozc.&fc=200003',
    },
    {
      name: 'Třebenice, náměstí',
      distance: '~650 m',
      destinations: 'Hlavní zastávka s nejvíce spoji. Cíle: Libčeves, Třebívlice, Lovosice, Litoměřice, Most, Evaň (Libochovice), Klapý, Peruc.',
      departures: 'https://idos.cz/vlakyautobusymhdvse/odjezdy/vysledky/?f=T%C5%99ebenice,,n%C3%A1m.;%20Litom%C4%9B%C5%99ice&fc=200003',
    },
    {
      name: 'Třebenice, Dlažkovická',
      distance: '~700 m',
      destinations: 'Boční ulice u náměstí. Cíle: Lovosice.',
      departures: 'https://idos.cz/vlakyautobusymhdvse/odjezdy/vysledky/?f=T%C5%99ebenice,,Dla%C5%BEkovick%C3%A1;%20Litom%C4%9B%C5%99ice&fc=200003',
    },
  ],
  train: [
    {
      name: 'Třebenice město',
      distance: '~900 m',
      destinations: 'Trať U10 <a href="https://www.svestkovadraha.cz/" target="_blank" rel="noreferrer">Švestková dráha</a> (Litoměřice horní nádraží – Most), směr Litoměřice a Most.',
      departures: 'https://idos.cz/vlakyautobusymhdvse/odjezdy/vysledky/?f=T%C5%99ebenice%20m%C4%9Bsto&fc=100003',
      timetable: 'https://www.svestkovadraha.cz/jizdni-rad',
    },
  ],
  car: {
    note: 'V Kololeči silnice končí, obcí tedy neprojíždí žádná tranzitní doprava. Příjezd je vždy od Třebenic.',
    distances: [
      ['Třebenice (služby, náměstí)', '~1 km'],
      ['Dálnice D8 (sjezd Lovosice)', '~5 km'],
      ['Lovosice', '~9 km'],
      ['Litoměřice', '~16 km'],
      ['Praha', '~70 km'],
    ],
  },
};

// Odpady mají vlastní layout (karty podle druhu odpadu) s proklikem na zdroj.
const iconTrash = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"/><path d="M10 11v6M14 11v6"/></svg>';
const iconSort = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/></svg>';
const iconLeaf = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 18c0-7 6-12 14-13 0 8-5 14-13 14"/><path d="M5 18c2-4 5-7 9-8"/></svg>';
const iconWarning = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 16H3z"/><path d="M12 10v4M12 17h.01"/></svg>';
const iconBuilding = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V9l9-5 9 5v12"/><path d="M3 21h18"/><path d="M9 21v-6h6v6"/></svg>';
const iconCoins = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6.5 12h.01M17.5 12h.01"/></svg>';

const waste = [
  {
    title: 'Směsný odpad',
    icon: iconTrash,
    text: 'Popelnice se vyvážejí zpravidla 1× za 14 dní; přesný den a týden se řídí nálepkou na nádobě. Od roku 2026 se vyvážejí pouze nádoby s RFID čipem – o očipování požádejte na městském úřadě (Ing. Žalovič, 606 054 303).',
    link: { label: 'Harmonogram svozu', href: 'https://www.mesto-trebenice.cz/trideny-odpad' },
  },
  {
    title: 'Tříděný odpad v obci',
    icon: iconSort,
    text: 'Kontejnery jsou v Kololeči u trafostanice: papír, barevné sklo, plasty a kovy. Plasty se svážejí přibližně každý týden, papír zhruba 1× za 14 dní, sklo a kovy zhruba 1× za 4 týdny.',
    link: { label: 'Tříděný odpad', href: 'https://www.mesto-trebenice.cz/trideny-odpad' },
  },
  {
    title: 'Bioodpad',
    icon: iconLeaf,
    text: 'Samostatné stanoviště na bioodpad v Kololeči není – větší množství (tráva, větve, listí) patří do sběrného dvora v Třebenicích. Spalování trávy a listí je zakázané.',
    link: { label: 'Sběrný dvůr', href: 'https://www.mesto-trebenice.cz/sberne-misto-bioodpadu' },
  },
  {
    title: 'Objemný a nebezpečný odpad',
    icon: iconWarning,
    text: 'Nábytek, dřevo, elektro, nebezpečný odpad i textil odevzdáte ve sběrném dvoře v Třebenicích. Město také občas pořádá mobilní svoz kusového odpadu – termíny hlásí úřední deska.',
    link: { label: 'Sběrný dvůr', href: 'https://www.mesto-trebenice.cz/sberne-misto-bioodpadu' },
  },
  {
    title: 'Sběrný dvůr Třebenice',
    icon: iconBuilding,
    text: 'Žlábkova 34, Třebenice (u ČOV). Otevřeno zpravidla v úterý a čtvrtek odpoledne a v sobotu dopoledne. Určen občanům Třebenic a místních částí včetně Kololeče; elektroodpad zdarma od kohokoli.',
    link: { label: 'Otevírací doba a pravidla', href: 'https://www.mesto-trebenice.cz/sberne-misto-bioodpadu' },
  },
  {
    title: 'Poplatek za odpad',
    icon: iconCoins,
    text: '1 000 Kč za poplatníka a rok, splatný do 30. dubna. Platit lze na pokladně městského úřadu nebo bankovním převodem.',
    link: { label: 'Poplatek za odpad', href: 'https://www.mesto-trebenice.cz/mistni-poplatek-za-odpad' },
  },
];

// Voda a energie
// POZOR: currentOutage odstranit po 2026-06-16T11:00
const currentOutage = {
  active: true, // nastavit na false po skončení odstávky
  date: '16. června 2026',
  time: '7:30–11:00',
  area: 'Většina č. p. v Kololeči (viz PDF)',
  pdf: 'https://www.mesto-trebenice.cz/file/3791041',
};

const utilities = {
  water: {
    provider: { name: 'Severočeské vodovody a kanalizace (SčVK)', url: 'https://www.scvk.cz/zakaznicky-servis/moje-obec/obec/?city_id=565768' },
    emergency: ['601 267 267', '840 111 111'],
    emergencyNote: 'Call centrum – nonstop, dle tarifu operátora',
    links: [
      { label: 'Havárie a odstávky (živý stav)', href: 'https://www.scvk.cz/zakaznicky-servis/moje-obec/obec/?city_id=565768' },
      { label: 'Registrace SMS/e-mail upozornění', href: 'https://portal.scvk.cz/smsinfo' },
    ],
    price: '156,59 Kč / m³ (vč. DPH, vodné + stočné, platnost od 1. 1. 2026)',
    priceNote: 'Cena platí pro region SVS. Celková částka zahrnuje dodání i odvod 1 m³ vody; u nemovitostí bez napojení na kanalizaci se stočné neúčtuje.',
    priceUrl: 'https://www.severoceskavoda.cz/vse-o-vode/',
  },
  electricity: {
    provider: { name: 'ČEZ Distribuce', url: 'https://www.cezdistribuce.cz' },
    emergency: ['800 850 860'],
    emergencyNote: 'Zdarma, nonstop pro poruchy; technické požadavky po–pá 8–18 h',
    links: [
      { label: 'Ověřit odstávku / poruchu (Bez Šťávy)', href: 'https://www.bezstavy.cz/' },
      { label: 'Plánované odstávky', href: 'https://www.cezdistribuce.cz/cs/pro-zakazniky/potrebuji-vyresit/stavajici-pripojeni/overeni-planovane-odstavky' },
      { label: 'Registrace upozornění (SMS / e-mail)', href: 'https://www.cezdistribuce.cz/sluzba' },
      { label: 'Aplikace Proud (ČEZ)', href: 'https://www.cezdistribuce.cz/cs/proud' },
    ],
  },
  lighting: {
    links: [
      { label: 'Nahlásit závadu (ÚŘAD v MOBILU)', href: 'https://mesto-trebenice.uradvmobilu.cz/default/issues' },
      { label: 'Kontakt na město', href: 'https://www.mesto-trebenice.cz/oficialni-kontakt' },
    ],
    note: 'Závady veřejného osvětlení hlaste prostřednictvím aplikace ÚŘAD v MOBILU nebo na podatelně MÚ Třebenice (tel. 416 594 301, podatelna@mesto-trebenice.cz).',
  },
  wastewater: {
    note: 'Způsob likvidace odpadních vod se může lišit podle konkrétní nemovitosti. Krajský Plán rozvoje vodovodů a kanalizací (PRVK) počítá s odváděním odpadních vod z bezodtokových jímek na ČOV Litoměřice.',
    links: [
      { label: 'Karta PRVK – Kololeč', href: 'https://prvk.kr-ustecky.cz/prvk/karty/nahled?id=582' },
      { label: 'SčVK – voda v mé obci', href: 'https://www.scvk.cz/zakaznicky-servis/moje-obec/obec/?city_id=565768' },
    ],
  },
};

const practicalSections = [
  {
    id: 'doprava',
    title: 'Doprava',
    intro: 'Do Kololeče se snadno dostanete autem, autobusem i vlakem. Obec zůstává klidná a bez tranzitní dopravy, přitom nejbližší zastávky leží jen pár minut pěšky.',
  },
  {
    id: 'odpady',
    title: 'Odpady',
    intro: 'Sběrná místa, svoz a poplatek za odpad. Konkrétní termíny svozu se liší podle ročního období – aktuální harmonogram proto najdete vždy na webu města Třebenice.',
  },
  {
    id: 'internet',
    title: 'Internet a mobilní signál',
    intro: 'Dostupnost připojení se může lišit podle konkrétního domu a technických možností v místě.',
    items: [
      ['Dostupní internetoví poskytovatelé', preparing],
      ['Dostupné technologie', 'Bezdrátové připojení, DSL, LTE nebo 5G - dostupnost ověříme podle konkrétních poskytovatelů.'],
    ],
    providers: [
      { name: placeholder, technology: preparing, note: 'Doplníme po ověření dostupnosti.' },
    ],
  },
  {
    id: 'voda-energie',
    title: 'Voda a energie',
    intro: 'Kontakty pro havárie, živý stav dodávek a hlášení závad pro vodovod, elektřinu, veřejné osvětlení a plyn.',
  },
  {
    id: 'sluzby',
    title: 'Služby v okolí',
    intro: 'Základní služby jsou dostupné především v nedalekých Třebenicích.',
    items: [
      ['Obchod', placeholder],
      ['Lékárna', placeholder],
      ['Lékař', placeholder],
      ['Pošta', placeholder],
      ['Školy', placeholder],
      ['Restaurace', placeholder],
      ['Výdejní boxy', placeholder],
      ['Sběrný dvůr', placeholder],
    ],
  },
  {
    id: 'urady',
    title: 'Úřady a důležité kontakty',
    intro: 'Odkazy na správu města, hlášení závad a krizové kontakty.',
    items: [
      ['Městský úřad Třebenice', 'Oficiální web města Třebenice.'],
      ['Osadní výbor Kololeč', placeholder],
      ['Úřední deska', placeholder],
      ['Hlášení závad', placeholder],
      ['Krizová telefonní čísla', '112 · jednotné evropské číslo tísňového volání'],
    ],
    actions: [
      { label: 'Otevřít web města', href: 'https://www.mesto-trebenice.cz/' },
      { label: 'Zobrazit úřední desku', href: null },
    ],
  },
  {
    id: 'novi-obyvatele',
    title: 'Pro nové obyvatele a majitele nemovitostí',
    intro: 'Základní orientace pro nové sousedy, vlastníky domů a pozemků.',
    items: [
      ['Katastrální mapa', 'Nahlížení do katastru nemovitostí pro katastrální území Kololeč.'],
      ['Kód katastrálního území', '769584'],
      ['Územní plán', placeholder],
      ['Stavební úřad', placeholder],
      ['Trvalý pobyt', placeholder],
      ['Místní poplatky', placeholder],
      ['Odpadové hospodářství', placeholder],
    ],
    actions: [
      { label: 'Otevřít katastrální mapu', href: 'https://sgi-nahlizenidokn.cuzk.gov.cz/marushka/default.aspx?themeid=3&MarQueryId=6D2BCEB5&MarQParamCount=1&MarQParam0=769584&MarWindowName=Marushka' },
      { label: 'Otevřít web města', href: 'https://www.mesto-trebenice.cz/' },
    ],
  },
];
---

<BaseLayout
  title="Praktické informace | Kololeč"
  description="Doprava, odpady, internet, služby v okolí a důležité kontakty pro obyvatele Kololeče."
  navItems={subpageNav}
  bodyClass="archive-page practical-page"
  headerSolid
>
  <main id="obsah">
    <section class="archive-hero practical-hero">
      <div class="shell">
        <p class="section-kicker">Praktický rozcestník</p>
        <h1>Praktické informace</h1>
        <p>Užitečné odkazy a kontakty pro každodenní život v Kololeči. Doprava, odpady, internet, služby v okolí i informace pro nové obyvatele na jednom místě.</p>
      </div>
    </section>

    <nav class="practical-nav" aria-label="Rozcestník praktických informací">
      <div class="shell">
        <ul class="practical-nav-list">
          {practicalSections.map((section) => (
            <li><a href={`#${section.id}`}>{section.title}</a></li>
          ))}
        </ul>
      </div>
    </nav>

    <div class="practical-blocks">
      {practicalSections.map((section, index) => {
        const num = `${String(index + 1).padStart(2, '0')} / ${String(practicalSections.length).padStart(2, '0')}`;

        if (section.id === 'doprava') {
          return (
            <section class="practical-block practical-block--wide" id={section.id} aria-labelledby={`${section.id}-title`}>
              <div class="shell">
                <div class="practical-block-head">
                  <p class="section-kicker">{num}</p>
                  <h2 id={`${section.id}-title`}>{section.title}</h2>
                  <p set:html={section.intro}></p>
                </div>

                <div class="transport-modes">
                  <article class="transport-mode">
                    <div class="transport-mode-head">
                      <span class="transport-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M3 11h18"/><path d="M7 16v2M17 16v2"/><circle cx="7.5" cy="13.5" r="1"/><circle cx="16.5" cy="13.5" r="1"/></svg>
                      </span>
                      <h3>Autobusem</h3>
                    </div>
                    <ul class="transport-stops">
                      {transport.bus.map((stop) => (
                        <li>
                          <div class="transport-stop-main">
                            <strong>{stop.name}</strong>
                            <span class="transport-dist">{stop.distance}</span>
                          </div>
                          <p class="transport-dest" set:html={stop.destinations}></p>
                          <span class="transport-links">
                            {stop.departures
                              ? <a class="transport-link" href={stop.departures} target="_blank" rel="noreferrer">Odjezdy →</a>
                              : <span class="transport-soon">Odjezdy doplníme</span>}
                            {stop.timetable && <a class="transport-link" href={stop.timetable} target="_blank" rel="noreferrer">Jízdní řád →</a>}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </article>

                  <article class="transport-mode">
                    <div class="transport-mode-head">
                      <span class="transport-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="13" rx="3"/><path d="M5 10h14"/><path d="M9 16l-2 4M15 16l2 4"/><circle cx="9" cy="13" r="0.9"/><circle cx="15" cy="13" r="0.9"/></svg>
                      </span>
                      <h3>Vlakem</h3>
                    </div>
                    <ul class="transport-stops">
                      {transport.train.map((stop) => (
                        <li>
                          <div class="transport-stop-main">
                            <strong>{stop.name}</strong>
                            <span class="transport-dist">{stop.distance}</span>
                          </div>
                          <p class="transport-dest" set:html={stop.destinations}></p>
                          <span class="transport-links">
                            {stop.departures
                              ? <a class="transport-link" href={stop.departures} target="_blank" rel="noreferrer">Odjezdy →</a>
                              : <span class="transport-soon">Odjezdy doplníme</span>}
                            {stop.timetable && <a class="transport-link" href={stop.timetable} target="_blank" rel="noreferrer">Jízdní řád →</a>}
                          </span>
                        </li>
                      ))}
                    </ul>
                    <figure class="transport-image">
                      <a href="https://www.svestkovadraha.cz/historie" target="_blank" rel="noreferrer">
                        <img src="/assets/svestkova-draha.png" alt="Motorový vůz na Švestkové dráze" loading="lazy" />
                      </a>
                    </figure>
                  </article>

                  <article class="transport-mode">
                    <div class="transport-mode-head">
                      <span class="transport-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l1.8-5A2 2 0 0 1 6.7 6.7h10.6A2 2 0 0 1 19.2 8L21 13"/><path d="M3 13h18v4a1 1 0 0 1-1 1h-1.2a1 1 0 0 1-1-1v-1H6.2v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><circle cx="7" cy="15.4" r="0.7"/><circle cx="17" cy="15.4" r="0.7"/></svg>
                      </span>
                      <h3>Autem</h3>
                    </div>
                    <ul class="transport-distances">
                      {transport.car.distances.map(([place, value]) => (
                        <li><strong>{place}</strong><span>{value}</span></li>
                      ))}
                    </ul>
                    <p class="transport-note">{transport.car.note}</p>
                  </article>
                </div>

                <p class="transport-note transport-tickets">Jízdenky na autobus i vlak jsou v rámci <a href="https://www.kr-ustecky.cz/doprava-usteckeho-kraje" target="_blank" rel="noreferrer">Dopravy Ústeckého kraje (DÚK)</a> integrované – jednou jízdenkou tak zvládnete celou cestu i s přestupy (v rámci Ústeckého kraje). Nejpohodlněji a se slevou je koupíte v mobilní aplikaci <a href="https://www.dukapka.cz/" target="_blank" rel="noreferrer">DÚKApka</a>.</p>

                <div class="practical-actions transport-actions">
                  <a class="button button-outline practical-button" href="https://www.dukapka.cz/" target="_blank" rel="noreferrer">Jízdenky – DÚKApka</a>
                  <a class="button button-outline practical-button" href="https://idos.cz/" target="_blank" rel="noreferrer">Vyhledat spojení (IDOS)</a>
                </div>
              </div>
            </section>
          );
        }

        if (section.id === 'odpady') {
          return (
            <section class="practical-block practical-block--wide" id={section.id} aria-labelledby={`${section.id}-title`}>
              <div class="shell">
                <div class="practical-block-head">
                  <p class="section-kicker">{num}</p>
                  <h2 id={`${section.id}-title`}>{section.title}</h2>
                  <p>{section.intro}</p>
                </div>

                <div class="waste-grid">
                  {waste.map((card) => (
                    <article class="waste-card">
                      <div class="waste-card-head">
                        <span class="waste-icon" aria-hidden="true" set:html={card.icon}></span>
                        <h3>{card.title}</h3>
                      </div>
                      <p>{card.text}</p>
                      {card.link && (
                        <a class="waste-link" href={card.link.href} target="_blank" rel="noreferrer">{card.link.label} →</a>
                      )}
                    </article>
                  ))}
                </div>
              </div>
            </section>
          );
        }

        if (section.id === 'voda-energie') {
          return (
            <section class="practical-block practical-block--wide" id={section.id} aria-labelledby={`${section.id}-title`}>
              <div class="shell">
                <div class="practical-block-head">
                  <p class="section-kicker">{num}</p>
                  <h2 id={`${section.id}-title`}>{section.title}</h2>
                  <p>{section.intro}</p>
                </div>

                {currentOutage.active && (
                  <div class="utility-alert" role="alert">
                    <span class="utility-alert-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </span>
                    <div>
                      <strong>Plánovaná odstávka elektřiny</strong>
                      <p>{currentOutage.date}, {currentOutage.time} – {currentOutage.area}</p>
                    </div>
                    <a href={currentOutage.pdf} target="_blank" rel="noreferrer" class="utility-alert-link">Zobrazit PDF →</a>
                  </div>
                )}

                <div class="utility-grid">
                  <article class="utility-card">
                    <div class="utility-card-head">
                      <span class="utility-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.5 2 4 7 4 10c0 4 3.6 8 8 8s8-4 8-8c0-3-2.5-8-8-8z"/><path d="M12 18v4M8 22h8"/></svg>
                      </span>
                      <h3>Voda</h3>
                    </div>
                    <p class="utility-provider"><a href={utilities.water.provider.url} target="_blank" rel="noreferrer">{utilities.water.provider.name}</a></p>
                    <div class="utility-emergency">
                      <span class="utility-emergency-label">Havárie</span>
                      <div class="utility-phones">
                        {utilities.water.emergency.map((tel) => (
                          <a href={`tel:${tel.replace(/ /g,'')}`} class="utility-phone">{tel}</a>
                        ))}
                      </div>
                      <p class="utility-emergency-note">{utilities.water.emergencyNote}</p>
                    </div>
                    <div class="utility-links">
                      {utilities.water.links.map((l) => (
                        <a href={l.href} target="_blank" rel="noreferrer" class="utility-link">{l.label} →</a>
                      ))}
                    </div>
                    <div class="utility-price">
                      <span class="utility-price-value">{utilities.water.price}</span>
                      <p class="utility-price-note">{utilities.water.priceNote} <a href={utilities.water.priceUrl} target="_blank" rel="noreferrer">Více o cenách →</a></p>
                    </div>
                  </article>

                  <article class="utility-card">
                    <div class="utility-card-head">
                      <span class="utility-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                      </span>
                      <h3>Elektřina</h3>
                    </div>
                    <p class="utility-provider"><a href={utilities.electricity.provider.url} target="_blank" rel="noreferrer">{utilities.electricity.provider.name}</a></p>
                    <div class="utility-emergency">
                      <span class="utility-emergency-label">Porucha</span>
                      <div class="utility-phones">
                        {utilities.electricity.emergency.map((tel) => (
                          <a href={`tel:${tel.replace(/ /g,'')}`} class="utility-phone">{tel}</a>
                        ))}
                      </div>
                      <p class="utility-emergency-note">{utilities.electricity.emergencyNote}</p>
                    </div>
                    <div class="utility-links">
                      {utilities.electricity.links.map((l) => (
                        <a href={l.href} target="_blank" rel="noreferrer" class="utility-link">{l.label} →</a>
                      ))}
                    </div>
                  </article>

                  <article class="utility-card utility-card--slim">
                    <div class="utility-card-head">
                      <span class="utility-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>
                      </span>
                      <h3>Veřejné osvětlení</h3>
                    </div>
                    <p class="utility-note">{utilities.lighting.note}</p>
                    <div class="utility-links">
                      {utilities.lighting.links.map((l) => (
                        <a href={l.href} target="_blank" rel="noreferrer" class="utility-link">{l.label} →</a>
                      ))}
                    </div>
                  </article>

                  <article class="utility-card utility-card--slim">
                    <div class="utility-card-head">
                      <span class="utility-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v8"/><path d="M5.2 10.2a7 7 0 1 0 13.6 0"/><path d="M3 10h18"/></svg>
                      </span>
                      <h3>Odpadní vody</h3>
                    </div>
                    <p class="utility-note">{utilities.wastewater.note}</p>
                    <div class="utility-links">
                      {utilities.wastewater.links.map((l) => (
                        <a href={l.href} target="_blank" rel="noreferrer" class="utility-link">{l.label} →</a>
                      ))}
                    </div>
                  </article>
                </div>
              </div>
            </section>
          );
        }

        return (
          <section class="practical-block" id={section.id} aria-labelledby={`${section.id}-title`}>
            <div class="shell practical-block-inner">
              <div class="practical-block-head">
                <p class="section-kicker">{num}</p>
                <h2 id={`${section.id}-title`}>{section.title}</h2>
                <p>{section.intro}</p>
              </div>

              <div class="practical-block-body">
                <dl class="practical-list">
                  {section.items.map(([term, detail]) => (
                    <div>
                      <dt>{term}</dt>
                      <dd>{detail}</dd>
                    </div>
                  ))}
                </dl>

                {section.providers && (
                  <div class="provider-table" role="table" aria-label="Přehled poskytovatelů internetu">
                    <div role="row" class="provider-table-head">
                      <span role="columnheader">Poskytovatel</span>
                      <span role="columnheader">Technologie</span>
                      <span role="columnheader">Poznámka</span>
                    </div>
                    {section.providers.map((provider) => (
                      <div role="row">
                        <span role="cell">{provider.name}</span>
                        <span role="cell">{provider.technology}</span>
                        <span role="cell">{provider.note}</span>
                      </div>
                    ))}
                  </div>
                )}

                {section.actions && (
                  <div class="practical-actions">
                    {section.actions.map((action) => (
                      action.href ? (
                        <a class="button button-outline practical-button" href={action.href} target="_blank" rel="noreferrer">{action.label}</a>
                      ) : (
                        <span class="practical-placeholder">{action.label}: {preparing}</span>
                      )
                    ))}
                  </div>
                )}
              </div>
            </div>
          </section>
        );
      })}
    </div>
  </main>
</BaseLayout>

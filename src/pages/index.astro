---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const byDateDesc = (a, b) => b.data.date.valueOf() - a.data.date.valueOf();
const aktuality = (await getCollection('aktuality')).sort(byDateDesc);
const udalosti = (await getCollection('udalosti')).sort(byDateDesc);

const now = new Date();
const udalostiUpcoming = udalosti
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const udalostiPast = udalosti.filter((e) => e.data.date < now);

const navItems = [
  { href: '#o-obci', label: 'O obci' },
  { href: '#zivot', label: 'Život' },
  { href: '/prakticke/', label: 'Praktické' },
  { href: '#historie', label: 'Historie' },
  { href: '#pamatky', label: 'Památky' },
  { href: '#galerie', label: 'Galerie' },
  { href: '#okoli', label: 'V okolí' },
  { href: '#mapa', label: 'Mapa' },
];
---

<BaseLayout navItems={navItems} leaflet scrollTopBrand>
  <main id="obsah">
    <section class="hero" aria-labelledby="hero-title">
            <img class="hero-image" src="/assets/kololec-naves.jpg" alt="Náves v Kololeči s kapličkou a hradem Košťálov v pozadí" />
            <div class="hero-shade"></div>
            <div class="shell hero-content">
              <p class="eyebrow">Ústecký kraj · okres Litoměřice</p>
              <h1 id="hero-title">Kololeč</h1>
              <p class="hero-lead">Malá vesnice v krajině Českého středohoří, jen kilometr západně od Třebenic.</p>
              <div class="hero-actions">
                <a class="button button-primary" href="#o-obci">Poznejte Kololeč</a>
                <a class="button button-glass" href="#mapa">Kde nás najdete</a>
              </div>
            </div>
            <a class="hero-credit" href="https://commons.wikimedia.org/wiki/File:Kolole%C4%8D_n%C3%A1ves.jpg" target="_blank" rel="noreferrer">Foto: Gortyna / Wikimedia Commons</a>
          </section>
    
          <section class="intro section" id="o-obci" aria-labelledby="intro-title">
            <div class="shell intro-grid">
              <div>
                <p class="section-kicker">O obci</p>
                <h2 id="intro-title">Klidné místo nedaleko Třebenic</h2>
              </div>
              <div class="intro-copy">
                <p>Kololeč je malá vesnice a část města Třebenice v okrese Litoměřice. Leží přibližně jeden kilometr západně od Třebenic, při severozápadní hranici okresu a na úpatí Kozích horek.</p>
                <p>Na návsi najdete kapličku, sochu svatého Jana Nepomuckého i zastřešené odpočívadlo. Zvláštností obce je, že v Kololeči končí silnice, a tak si vesnice drží klid bez většího průjezdného provozu.</p>
              </div>
            </div>
            <div class="shell intro-drawings" aria-label="Kololeč v kresbách Bedřicha Tomáška">
              <a class="intro-drawing reveal" href="/assets/archive/uvod-stareho-webu-1.jpg" target="_blank">
                <img src="/assets/archive/uvod-stareho-webu-1.jpg" alt="Kresba Kololeče s návsí, kapličkou a Košťálovem v pozadí" loading="lazy" />
              </a>
              <a class="intro-drawing reveal" href="/assets/archive/uvod-stareho-webu-3.jpg" target="_blank">
                <img src="/assets/archive/uvod-stareho-webu-3.jpg" alt="Kresba cesty v Kololeči s domy a výhledem ke Košťálovu" loading="lazy" />
              </a>
              <a class="intro-drawing reveal" href="/assets/archive/uvod-stareho-webu-5.jpg" target="_blank">
                <img src="/assets/archive/uvod-stareho-webu-5.jpg" alt="Kresba Kololeče s cestou a vrchem Košťálov" loading="lazy" />
              </a>
              <a class="intro-drawing reveal" href="/assets/archive/uvod-stareho-webu-7.jpg" target="_blank">
                <img src="/assets/archive/uvod-stareho-webu-7.jpg" alt="Kresba domů v Kololeči podél cesty" loading="lazy" />
              </a>
            </div>
          </section>
    
          <section class="facts" aria-label="Základní údaje">
            <div class="shell facts-grid">
              <article class="fact-card reveal">
                <strong>1436</strong>
                <span>první písemná zmínka</span>
              </article>
              <article class="fact-card reveal">
                <strong>98</strong>
                <span>Obyvatel</span>
              </article>
              <article class="fact-card reveal">
                <strong>37</strong>
                <span>obytných domů</span>
              </article>
              <article class="fact-card reveal">
                <strong>1,50 km²</strong>
                <span>výměra katastrálního území</span>
              </article>
              <article class="fact-card reveal">
                <strong>254 m</strong>
                <span>nadmořská výška</span>
              </article>
              <article class="fact-card reveal">
                <strong>411 15</strong>
                <span>poštovní směrovací číslo</span>
              </article>
              <article class="fact-card reveal">
                <a class="fact-link" href="https://sgi-nahlizenidokn.cuzk.gov.cz/marushka/default.aspx?themeid=3&MarQueryId=6D2BCEB5&MarQParamCount=1&MarQParam0=769584&MarWindowName=Marushka" target="_blank" rel="noreferrer">
                  <strong>769584</strong>
                  <span>kód katastrálního území</span>
                </a>
              </article>
              <article class="fact-card reveal">
                <strong>~70 km</strong>
                <span>od Prahy</span>
              </article>
            </div>
          </section>
    
          <section class="section village-life" id="zivot" aria-labelledby="life-title">
            <div class="shell">
              <p class="section-kicker">Život v obci</p>
              <div class="section-heading-row">
                <h2 id="life-title">Náves jako přirozené místo setkávání</h2>
                <p>Kololeč je především sousedská obec, kde se společné věci dějí venku, na návsi a kolem kapličky. Po celý rok se tu střídají sousedská posezení, sportovní klání i péče o obec.</p>
              </div>

              <div class="life-grid">
                <article class="life-card reveal">
                  <div class="life-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                      <circle cx="9" cy="7" r="4"></circle>
                      <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                  </div>
                  <span>Setkávání</span>
                  <h3>Vánoce, Mikuláš i sousedská posezení</h3>
                  <p>V obci nechybí zpívání koled na Štědrý den, rozsvícení stromu, mikulášská nadílka, rozloučení s létem i novoroční ohňostroje.</p>
                </article>
                <article class="life-card reveal">
                  <div class="life-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 20h10M12 20V10M12 10a6 6 0 0 1 6-6M12 10a6 6 0 0 0-6-6M12 14a4 4 0 0 1 4-4M12 14a4 4 0 0 0-4-4"></path>
                    </svg>
                  </div>
                  <span>Péče o obec</span>
                  <h3>Brigády a úklid společných míst</h3>
                  <p>Pravidelně se konají jarní a podzimní brigády, údržba návsi, péče o zeleň a drobné práce, které udržují vesnici upravenou.</p>
                </article>
                <article class="life-card reveal">
                  <div class="life-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="8" r="7"></circle>
                      <path d="M8.21 13.89 7 23l5-3 5 3-1.21-9.12"></path>
                    </svg>
                  </div>
                  <span>Akce pro všechny</span>
                  <h3>Dětské dny, sport a drobné slavnosti</h3>
                  <p>V obci se konají dětské dny, pingpongové turnaje, MDŽ, velikonoční setkávání i další malé události, které drží obec pohromadě.</p>
                </article>
              </div>

              <aside class="practical-callout reveal" aria-labelledby="practical-callout-title">
                <div>
                  <p class="section-kicker">Praktický rozcestník</p>
                  <h3 id="practical-callout-title">Praktické informace pro každodenní život</h3>
                  <p>Jízdní řády, svoz odpadu, dostupnost internetu, důležité kontakty a služby v okolí na jednom místě.</p>
                  <small>Doprava · Odpady · Internet · Kontakty</small>
                </div>
                <a class="button button-primary" href="/prakticke/">Praktické informace →</a>
              </aside>

              <div class="zivot-feed">
                <section class="feed-column" aria-labelledby="aktuality-title">
                  <div class="feed-head">
                    <p class="section-kicker">Aktuality</p>
                    <h3 id="aktuality-title">Co je nového</h3>
                  </div>
                  <ol class="feed-list">
                    {aktuality.slice(0, 3).map((post) => <PostCard post={post} base="/aktuality" />)}
                  </ol>
                  <a class="feed-all" href="/aktuality/">Všechny aktuality →</a>
                </section>

                <section class="feed-column" aria-labelledby="udalosti-title">
                  <div class="feed-head">
                    <p class="section-kicker">Události</p>
                    <h3 id="udalosti-title">Nadcházející akce</h3>
                  </div>
                  {udalostiUpcoming.length > 0 ? (
                    <ol class="feed-list">
                      {udalostiUpcoming.slice(0, 3).map((post) => <PostCard post={post} base="/udalosti" />)}
                    </ol>
                  ) : (
                    <p class="feed-empty">Aktuálně nejsou naplánované žádné akce. Jakmile nějakou připravíme, objeví se tady i na naší facebookové skupině.</p>
                  )}

                  <div class="feed-subhead">
                    <h4>Poslední události</h4>
                  </div>
                  <ol class="feed-list">
                    {udalostiPast.slice(0, 3).map((post) => <PostCard post={post} base="/udalosti" />)}
                  </ol>
                  <a class="feed-all" href="/udalosti/">Všechny události →</a>
                </section>
              </div>
            </div>
          </section>
    
          <section class="section history history-teaser" id="historie" aria-labelledby="history-title">
            <div class="shell">
              <div class="story-grid history-teaser-grid">
                <a class="history-photo reveal" href="/historie/">
                  <img src="/assets/archive/historicke-fotografie-91.jpg" alt="Kololeč na dobové kresbě s hradem Košťálov" loading="lazy" />
                </a>
                <div class="story-copy">
                  <p class="section-kicker">Historie</p>
                  <h2 id="history-title">Příběh malé vsi napříč staletími</h2>
                  <p>Od nejstarších zmínek ve 14. století přes kapličku na návsi a obě světové války až po obnovení osadního výboru. Celou časovou osu, kronikáře, osobnosti i dobové snímky najdete na samostatné stránce.</p>
                  <a class="button button-primary history-teaser-cta" href="/historie/">Prozkoumat historii obce →</a>
                </div>
              </div>

              <ol class="history-highlights">
                <li class="history-highlight reveal">
                  <strong>1364</strong>
                  <span>první písemná zmínka o obci</span>
                </li>
                <li class="history-highlight reveal">
                  <strong>1921</strong>
                  <span>založena obecní kronika</span>
                </li>
                <li class="history-highlight reveal">
                  <strong>1948</strong>
                  <span>elektrifikace a místní rozhlas</span>
                </li>
                <li class="history-highlight reveal">
                  <strong>2008</strong>
                  <span>obnoven osadní výbor</span>
                </li>
              </ol>
            </div>
          </section>
    
          <section class="section landmarks" id="pamatky" aria-labelledby="landmarks-title">
            <div class="shell">
              <p class="section-kicker">Pamětihodnosti</p>
              <div class="section-heading-row">
                <h2 id="landmarks-title">Místa, která tvoří náves</h2>
                <p>Dvě drobné památky připomínají historii i charakter obce.</p>
              </div>
    
              <div class="landmark-grid">
                <article class="landmark-card reveal">
                  <div class="landmark-image-wrap">
                    <img src="/assets/kololec-kaplicka.jpg" alt="Kaplička na návsi v Kololeči" loading="lazy" />
                  </div>
                  <div class="landmark-card-copy">
                    <span class="card-number">01</span>
                    <h3>Kaplička</h3>
                    <p>Drobná sakrální stavba stojí přímo na návsi a tvoří přirozený střed vesnice.</p>
                  </div>
                </article>
    
                <article class="landmark-card reveal">
                  <div class="landmark-image-wrap">
                    <img src="/assets/kololec-jan-nepomucky.jpg" alt="Socha svatého Jana Nepomuckého v Kololeči" loading="lazy" />
                  </div>
                  <div class="landmark-card-copy">
                    <span class="card-number">02</span>
                    <h3>Socha svatého Jana Nepomuckého</h3>
                    <p>Kamenná socha na zdobeném podstavci patří mezi místní pamětihodnosti.</p>
                  </div>
                </article>
              </div>
            </div>
          </section>
    
          <section class="section gallery" id="galerie" aria-labelledby="gallery-title">
            <div class="shell">
              <p class="section-kicker">Galerie</p>
              <div class="section-heading-row">
                <h2 id="gallery-title">Několik pohledů na Kololeč</h2>
                <p>Fotografie zachycují náves, drobné památky i další pohledy na obec.</p>
              </div>
              <div class="gallery-grid">
                <a class="gallery-item gallery-wide reveal" href="/assets/kololec-naves.jpg" target="_blank">
                  <img src="/assets/kololec-naves.jpg" alt="Náves v Kololeči" loading="lazy" />
                  <span>Náves a výhled ke Košťálovu</span>
                </a>
                <a class="gallery-item gallery-tall reveal" href="/assets/kololec-kaplicka.jpg" target="_blank">
                  <img src="/assets/kololec-kaplicka.jpg" alt="Kaplička v Kololeči" loading="lazy" />
                  <span>Kaplička</span>
                </a>
                <a class="gallery-item reveal" href="/assets/kololec-jan-nepomucky.jpg" target="_blank">
                  <img src="/assets/kololec-jan-nepomucky.jpg" alt="Socha svatého Jana Nepomuckého" loading="lazy" />
                  <span>Socha svatého Jana Nepomuckého</span>
                </a>
                <a class="gallery-item reveal" href="/assets/kololec-odpocivadlo.jpg" target="_blank">
                  <img src="/assets/kololec-odpocivadlo.jpg" alt="Odpočívadlo na návsi" loading="lazy" />
                  <span>Odpočívadlo na návsi</span>
                </a>
                <a class="gallery-item reveal" href="/assets/archive/historicke-fotografie-121.jpg" target="_blank">
                  <img src="/assets/archive/historicke-fotografie-121.jpg" alt="Hrad Košťálov nad zasněženou Kololečí" loading="lazy" />
                  <span>Košťálov nad obcí v zimě</span>
                </a>
                <a class="gallery-item reveal" href="/assets/archive/historicke-fotografie-123.jpg" target="_blank">
                  <img src="/assets/archive/historicke-fotografie-123.jpg" alt="Socha svatého Jana Nepomuckého v zimě" loading="lazy" />
                  <span>Socha sv. Jana Nepomuckého v zimě</span>
                </a>
                <a class="gallery-item reveal" href="/assets/rajce-wintermans/kololec-425.jpg" target="_blank">
                  <img src="/assets/rajce-wintermans/kololec-425.jpg" alt="Pohled na Kololeč z fotoalba Františka Kinaře" loading="lazy" />
                  <span>Kololeč · foto: František Kinař (2012)</span>
                </a>
                <a class="gallery-item reveal" href="/assets/rajce-wintermans/kololec-426.jpg" target="_blank">
                  <img src="/assets/rajce-wintermans/kololec-426.jpg" alt="Pohled na Kololeč z fotoalba Františka Kinaře" loading="lazy" />
                  <span>Kololeč · foto: František Kinař (2012)</span>
                </a>
                <a class="gallery-item reveal" href="/assets/rajce-wintermans/kololec-427.jpg" target="_blank">
                  <img src="/assets/rajce-wintermans/kololec-427.jpg" alt="Detail v Kololeči z fotoalba Františka Kinaře" loading="lazy" />
                  <span>Kololeč · foto: František Kinař (2012)</span>
                </a>
                <a class="gallery-item reveal" href="/assets/rajce-wintermans/kololec-428.jpg" target="_blank">
                  <img src="/assets/rajce-wintermans/kololec-428.jpg" alt="Pohled na Kololeč z fotoalba Františka Kinaře" loading="lazy" />
                  <span>Kololeč · foto: František Kinař (2012)</span>
                </a>
                <a class="gallery-item reveal" href="/assets/rajce-wintermans/kololec-430.jpg" target="_blank">
                  <img src="/assets/rajce-wintermans/kololec-430.jpg" alt="Pohled na Kololeč z fotoalba Františka Kinaře" loading="lazy" />
                  <span>Kololeč · foto: František Kinař (2012)</span>
                </a>
                <a class="gallery-item reveal" href="/assets/rajce-wintermans/kololec-431.jpg" target="_blank">
                  <img src="/assets/rajce-wintermans/kololec-431.jpg" alt="Detail v Kololeči z fotoalba Františka Kinaře" loading="lazy" />
                  <span>Kololeč · foto: František Kinař (2012)</span>
                </a>
                <a class="gallery-item reveal" href="/assets/rajce-wintermans/kololec-433.jpg" target="_blank">
                  <img src="/assets/rajce-wintermans/kololec-433.jpg" alt="Detail v Kololeči z fotoalba Františka Kinaře" loading="lazy" />
                  <span>Kololeč · foto: František Kinař (2012)</span>
                </a>
                <a class="gallery-item reveal" href="/assets/rajce-wintermans/kololec-434.jpg" target="_blank">
                  <img src="/assets/rajce-wintermans/kololec-434.jpg" alt="Detail v Kololeči z fotoalba Františka Kinaře" loading="lazy" />
                  <span>Kololeč · foto: František Kinař (2012)</span>
                </a>
              </div>
            </div>
          </section>
    
          <section class="section nearby" id="okoli" aria-labelledby="nearby-title">
            <div class="shell">
              <p class="section-kicker">V okolí</p>
              <div class="section-heading-row">
                <h2 id="nearby-title">Co najdete nedaleko Kololeče</h2>
                <p>Kololeč je dobrý výchozí bod pro krátké procházky, výhledy i výlety po Českém středohoří.</p>
              </div>
    
              <div class="nearby-grid">
                <a href="https://www.kudyznudy.cz/aktivity/zricenina-hradu-kostalov-v-ceskem-stredohori" target="_blank" rel="noreferrer" class="nearby-card reveal">
                  <div class="nearby-image-wrap">
                    <img src="/assets/nearby-kostalov.webp" alt="Zřícenina hradu Košťálov" loading="lazy" />
                    <span class="nearby-distance">1,8 km</span>
                  </div>
                  <div class="nearby-content">
                    <span class="nearby-tag">Výhledy</span>
                    <h3>Košťálov</h3>
                    <p>Zřícenina hradu na výrazném vrchu nad Třebenicemi patří k nejhezčím orientačním bodům v krajině.</p>
                  </div>
                </a>
                <a href="https://www.mesto-trebenice.cz/" target="_blank" rel="noreferrer" class="nearby-card reveal">
                  <div class="nearby-image-wrap">
                    <img src="/assets/nearby-trebenice.jpeg" alt="Pohled na město Třebenice" loading="lazy" />
                    <span class="nearby-distance">1,2 km</span>
                  </div>
                  <div class="nearby-content">
                    <span class="nearby-tag">Město</span>
                    <h3>Třebenice</h3>
                    <p>Historické město jen kousek od obce nabízí základní služby, muzeum českého granátu a napojení na další trasy.</p>
                  </div>
                </a>
                <a href="https://www.hrad-hazmburk.cz/" target="_blank" rel="noreferrer" class="nearby-card reveal">
                  <div class="nearby-image-wrap">
                    <img src="/assets/nearby-hazmburk.jpeg" alt="Zřícenina hradu Hazmburk" loading="lazy" />
                    <span class="nearby-distance">6,5 km</span>
                  </div>
                  <div class="nearby-content">
                    <span class="nearby-tag">Výlet</span>
                    <h3>Hazmburk</h3>
                    <p>Dominantní dvojice věží láká na delší výlet za výhledy přes dolní Poohří a kopce Českého středohoří.</p>
                  </div>
                </a>
                <a href="https://www.stredohori.cz/" target="_blank" rel="noreferrer" class="nearby-card reveal">
                  <div class="nearby-image-wrap">
                    <img src="/assets/nearby-ceske-stredohori.jpeg" alt="Krajina Českého středohoří" loading="lazy" />
                    <span class="nearby-distance">v okolí</span>
                  </div>
                  <div class="nearby-content">
                    <span class="nearby-tag">Krajina</span>
                    <h3>České středohoří</h3>
                    <p>Okolní louky, sady a sopečné vrchy se hodí for pomalé procházky, cyklistiku i nenáročné fotografování krajiny.</p>
                  </div>
                </a>
              </div>
            </div>
          </section>
    
          <section class="section map-section" id="mapa" aria-labelledby="map-title">
            <div class="shell map-grid">
              <div class="map-copy">
                <p class="section-kicker">Mapa</p>
                <h2 id="map-title">Kde najdete Kololeč</h2>
                <p>Kololeč leží západně od Třebenic v okrese Litoměřice. Mapa ukazuje širší území obce a nejbližší okolí.</p>
                <dl class="location-list">
                  <div>
                    <dt>Souřadnice</dt>
                    <dd>50°28′42″ s. š., 13°58′33″ v. d.</dd>
                  </div>
                  <div>
                    <dt>Správní celek</dt>
                    <dd>Třebenice · okres Litoměřice · Ústecký kraj</dd>
                  </div>
                  <div>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { subpageNav } from '../data/nav.mjs';

const posts = (await getCollection('aktuality')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const postsByYear = Array.from(
  posts.reduce((groups, post) => {
    const year = post.data.date.getFullYear();
    groups.set(year, [...(groups.get(year) ?? []), post]);
    return groups;
  }, new Map()),
);
---

<BaseLayout
  title="Aktuality – Kololeč"
  description="Novinky a oznámení ze života obce Kololeč."
  navItems={subpageNav}
  bodyClass="archive-page"
  headerSolid
>
  <main id="obsah">
    <section class="archive-hero">
      <div class="shell">
        <p class="section-kicker">Život v obci</p>
        <h1>Aktuality</h1>
        <p>Novinky a oznámení ze života obce Kololeč.</p>
      </div>
    </section>

    <section class="section post-list-section">
      <div class="shell">
        <div class="post-year-stack">
          {
            postsByYear.map(([year, yearPosts]) => (
              <section class="post-year-group" aria-labelledby={`aktuality-${year}`}>
                <h2 id={`aktuality-${year}`}>{year}</h2>
                <ol class="feed-list post-list-full">
                  {yearPosts.map((post) => <PostCard post={post} base="/aktuality" />)}
                </ol>
              </section>
            ))
          }
        </div>
        <p class="post-back"><a href="/#zivot">← Zpět na úvodní stránku</a></p>
      </div>
    </section>
  </main>
</BaseLayout>
